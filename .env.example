# ============================================================
# 星光国际影城 CMS 环境变量模板
# 复制为 .env 后修改：cp .env.example .env
# .env 已在 .gitignore 中，不会提交到仓库
# ============================================================

# ---- 数据库 ----
# 本机直连用 localhost；容器内由 compose 覆盖为 mysql 服务名
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cms
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- 后端运行环境（dev / prod）----
SPRING_PROFILES_ACTIVE=dev

# ---- 在线接口文档（生产建议 false 关闭）----
SPRINGDOC_ENABLED=true

# ---- JWT（生产必须更换，长度≥32 位随机字符串）----
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRE=86400000

# ---- 上传目录（本机开发可留空走 application.yml 默认值）----
# FILE_UPLOAD_PATH=F:/AI_full-stack_project/CMS/uploads/
